{
  "nodes": [
    {
      "id": "voice_input_rust",
      "type": "Project",
      "name": "VoiceInput Rust",
      "description": "完全ローカル LLM 音声入力デスクトップアプリ (Rust版)",
      "language": "Rust",
      "version": "0.1.0",
      "edition": "2021"
    },
    {
      "id": "voice_input_swift",
      "type": "Project",
      "name": "VoiceInput Swift",
      "description": "完全ローカル LLM 音声入力デスクトップアプリ (Swift版)",
      "language": "Swift",
      "swift_version": "6.0",
      "min_os": "macOS 15.0"
    },
    {
      "id": "vad_engine_protocol",
      "type": "EngineProtocol",
      "name": "VADEngine",
      "description": "音声区間検出 (Voice Activity Detection)",
      "methods": ["load", "unload", "warmup", "process"],
      "input": "AudioChunk",
      "output": "VADStatus"
    },
    {
      "id": "streaming_asr_engine_protocol",
      "type": "EngineProtocol",
      "name": "StreamingASREngine",
      "description": "リアルタイムプレビュー用ストリーミング音声認識",
      "methods": ["load", "unload", "processStream", "resetStream"],
      "input": "AudioChunk",
      "output": "String"
    },
    {
      "id": "batch_asr_engine_protocol",
      "type": "EngineProtocol",
      "name": "BatchASREngine",
      "description": "高精度確定転写用バッチ音声認識",
      "methods": ["load", "unload", "transcribe"],
      "input": "Data (Audio)",
      "output": "String"
    },
    {
      "id": "refiner_engine_protocol",
      "type": "EngineProtocol",
      "name": "RefinerEngine",
      "description": "LLM/ルールベース整形層",
      "responsibilities": [
        "フィラー除去",
        "言い直し解決",
        "句読点付与",
        "固有名詞表記変換",
        "逆テキスト正規化"
      ]
    },
    {
      "id": "audio_chunk_struct",
      "type": "DataStructure",
      "name": "AudioChunk",
      "fields": ["data", "sampleRate", "channels"],
      "default_sample_rate": 16000,
      "default_channels": 1
    },
    {
      "id": "vad_status_enum",
      "type": "Enum",
      "name": "VADStatus",
      "values": ["silence", "speechStarted", "speaking", "speechEnded"]
    },
    {
      "id": "refinement_strength_enum",
      "type": "Enum",
      "name": "RefinementStrength",
      "description": "テキスト整形の強度設定",
      "values": ["none", "light", "standard", "aggressive"]
    },
    {
      "id": "refiner_context_struct",
      "type": "DataStructure",
      "name": "RefinerContext",
      "fields": ["dictionary", "appCategory", "strength", "customInstruction"],
      "description": "LLM整形層のコンテキスト情報"
    },
    {
      "id": "pipeline_core",
      "type": "Component",
      "name": "Pipeline Core",
      "description": "OS非依存のパイプラインコア",
      "stages": [
        "AudioCapture",
        "VADEngine",
        "StreamingASREngine",
        "BatchASREngine",
        "OutputValidator",
        "RefinerEngine"
      ]
    },
    {
      "id": "macos_layer",
      "type": "Component",
      "name": "macOS Layer",
      "description": "macOS固有層",
      "responsibilities": [
        "メニューバーUI",
        "HUD (フローティングウィンドウ)",
        "グローバルホットキー",
        "アクセシビリティ挿入"
      ]
    },
    {
      "id": "text_inserter_component",
      "type": "Component",
      "name": "TextInserter",
      "description": "アクティブアプリのカーソル位置へのテキスト挿入",
      "file_rust": "src/inserter.rs",
      "file_swift": "Sources/voice_input/TextInserter.swift"
    },
    {
      "id": "user_dictionary_component",
      "type": "Component",
      "name": "UserDictionary",
      "description": "ユーザー辞書管理 (読み→表記のペア管理)",
      "file_rust": "src/dictionary.rs",
      "file_swift": "Sources/voice_input/UserDictionary.swift"
    },
    {
      "id": "audio_recorder_component",
      "type": "Component",
      "name": "AudioRecorder",
      "description": "音声キャプチャ",
      "file_rust": "src/audio.rs"
    },
    {
      "id": "requirement_privacy_security",
      "type": "Requirement",
      "req_id": "NFR-3",
      "name": "プライバシー・セキュリティ",
      "description": "音声・転写テキスト・辞書・履歴は端末外に送信しない。推論時のネットワーク通信はゼロ。"
    },
    {
      "id": "requirement_performance_latency",
      "type": "Requirement",
      "req_id": "NFR-1",
      "name": "性能 (レイテンシ予算)",
      "endpoint_target": "1.5秒以内 (標準構成・15秒発話)",
      "ideal_target": "1.0秒以内"
    },
    {
      "id": "requirement_plugin_architecture",
      "type": "Requirement",
      "req_id": "FR-5",
      "name": "エンジン管理 (差し替え可能性)",
      "description": "4コンポーネント (Streaming ASR/Batch ASR/LLM/VAD) を共通プロトコルの背後に実装し、コード変更なしでエンジンを差し替え可能"
    },
    {
      "id": "requirement_text_insertion",
      "type": "Requirement",
      "req_id": "FR-4",
      "name": "テキスト挿入機能",
      "features": [
        "アクティブアプリのカーソル位置に挿入",
        "ペーストボード退避・復元",
        "挿入履歴保持",
        "履歴の自動ローテーション"
      ]
    },
    {
      "id": "requirement_refiner_features",
      "type": "Requirement",
      "req_id": "FR-3",
      "name": "LLM整形層",
      "features": [
        "フィラー除去",
        "言い直し解決",
        "句読点付与",
        "固有名詞表記変換",
        "逆テキスト正規化",
        "文体プロファイル切り替え"
      ]
    },
    {
      "id": "requirement_hotkey_activation",
      "type": "Requirement",
      "req_id": "FR-1",
      "name": "音声入力の起動・終了",
      "features": [
        "グローバルホットキー対応 (Option + Space)",
        "メニューバー常駐アプリ",
        "フローティングHUD",
        "どのアプリでも動作"
      ]
    },
    {
      "id": "architecture_specification",
      "type": "Document",
      "name": "要件定義書: ローカルLLM音声入力デスクトップアプリ",
      "file": "voice_input_rust/docs/spec_要件定義書_ローカル音声入力アプリ.md",
      "version": "1.0",
      "status": "Rust実装完了 / リファレンス更新"
    },
    {
      "id": "dependency_cpal",
      "type": "Dependency",
      "name": "cpal",
      "version": "0.15",
      "purpose": "クロスプラットフォーム マイク音声入力"
    },
    {
      "id": "dependency_whisper_rs",
      "type": "Dependency",
      "name": "whisper-rs",
      "version": "0.13",
      "features": ["metal"],
      "purpose": "Apple Silicon (Metal) GPU アクセラレーション音声認識"
    },
    {
      "id": "dependency_egui",
      "type": "Dependency",
      "name": "egui / eframe",
      "version": "0.29",
      "purpose": "クロスプラットフォーム軽量GUI"
    },
    {
      "id": "dependency_tokio",
      "type": "Dependency",
      "name": "tokio",
      "version": "1.38",
      "purpose": "非同期ランタイム"
    },
    {
      "id": "dependency_arboard",
      "type": "Dependency",
      "name": "arboard",
      "version": "3.4",
      "purpose": "クリップボード操作"
    },
    {
      "id": "dependency_enigo",
      "type": "Dependency",
      "name": "enigo",
      "version": "0.2",
      "purpose": "キーイベント合成、テキスト挿入"
    },
    {
