      "refiner": "Qwen3.5-4B",
      "estimated_memory": "6GB",
      "use_case": "日常の既定"
    },
    {
      "id": "preset_lightweight",
      "type": "Preset",
      "name": "軽量",
      "streaming": "SpeechAnalyzer",
      "batch": "SpeechAnalyzer",
      "refiner": "Foundation Models",
      "estimated_memory": "1GB未満",
      "use_case": "省電力・外出時"
    },
    {
      "id": "test_suite_coverage",
      "type": "TestSuite",
      "name": "テストカバレッジ",
      "target": "100%",
      "modules": [
        "OutputValidator",
        "RuleBasedRefinerEngine",
        "UserDictionaryManager",
        "VoiceInputPipeline",
        "AppConfig",
        "EngineFactory"
      ]
    },
    {
      "id": "phase_p1_evaluation",
      "type": "DevPhase",
      "name": "P1: 評価基盤",
      "description": "評価データセット作成 + 評価ハーネス実装",
      "deliverables": ["各候補エンジンの実測レポート (CER/F1/RTF)", "既定エンジン決定"]
    },
    {
      "id": "phase_p2_pipeline",
      "type": "DevPhase",
      "name": "P2: コアパイプライン",
      "description": "プロトコル定義 + エンジンマネージャ + 最小パイプライン実装",
      "deliverables": ["マイク入力から整形済みテキストまでの処理"]
    },
    {
      "id": "phase_p3_desktop",
      "type": "DevPhase",
      "name": "P3: デスクトップアプリ化",
      "description": "メニューバー常駐、ホットキー、HUD、カーソル挿入、設定UI",
      "deliverables": ["日常業務で常用可能なアプリ"]
    },
    {
      "id": "phase_p4_streaming",
      "type": "DevPhase",
      "name": "P4: ストリーミング統合",
      "description": "StreamingASREngine統合、プレビュー表示",
      "performance_goal": "プレビュー遅延 <= 500ms"
    },
    {
      "id": "phase_p5_quality",
      "type": "DevPhase",
      "name": "P5: 品質引き上げ",
      "description": "アプリ別文体プロファイル、辞書自動提案、既製品との比較",
      "performance_goal": "NFR-4精度目標達成"
    },
    {
      "id": "risk_nemotron_accuracy",
      "type": "Risk",
      "name": "Nemotron日本語精度リスク",
      "impact": "プレビュー品質低下",
      "mitigation": "フェーズ1で最優先実測。不合格ならSpeechAnalyzerをプレビューに昇格"
    },
    {
      "id": "risk_llm_hallucination",
      "type": "Risk",
      "name": "LLM整形による意味改変",
      "impact": "信頼性低下",
      "mitigation": "整形強度設定 + 生出力フォールバック + 回帰テスト"
    },
